<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- No INTERNET / ACCESS_NETWORK_STATE on purpose: fully offline app, firmwares in the APK. -->

    <application
        android:label="Pebble Index Flasher"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.PebbleIndexFlasher">
        <!-- portrait: a rotation would recreate the Activity and abort a flash mid-SUOTA -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
